# =============================================================================
# .env.example — Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
# Usa comillas simples si la password tiene caracteres especiales como $
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=CHANGE_ME_airflow_password
AIRFLOW_ADMIN_EMAIL=admin@tuuniversidad.edu.co

# Genera FERNET_KEY con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_fernet_key_base64_32bytes

# Genera SECRET_KEY con:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=CHANGE_ME_random_hex_string
