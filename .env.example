# =============================================================================
# .env.example — Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =============================================================================

# ── PostgreSQL Aiven Cloud ────────────────────────────────────────────────────
# Para la API FastAPI (psycopg v3)
AIVEN_DB_URL=postgresql+psycopg://usuario:password@host:puerto/defaultdb?sslmode=require

# Para Airflow (psycopg2)
AIRFLOW_DB_URL=postgresql+psycopg2://usuario:password@host:puerto/defaultdb?sslmode=require

# ── Puertos publicados en host (Ubuntu) ─────────────────────────────────────
FRONTEND_PORT=8081
AIRFLOW_PORT=18080

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=CHANGE_ME_airflow_password
AIRFLOW_ADMIN_EMAIL=admin@tuuniversidad.edu.co

# Genera FERNET_KEY con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_fernet_key_base64_32bytes

# Genera SECRET_KEY con:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=CHANGE_ME_random_hex_string
